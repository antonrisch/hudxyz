{
  "name": "hudxyz",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @hudxyz/web dev",
    "ngrok": "ngrok http --url=cheerful-python-carefully.ngrok-free.app 3000",
    "build": "pnpm -r build",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.70.0"
  },
  "lint-staged": {
    "*.{js,ts,tsx,mjs,cjs,json,jsonc,css,md}": "oxfmt --write",
    "*.{js,ts,tsx,mjs,cjs}": "oxlint"
  }
}
