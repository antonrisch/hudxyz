# Wisp server endpoint — network egress for the Scramjet proxy. `pnpm dev` spins
# up a local wisp process on :4000; point this at your always-on host in prod.
NEXT_PUBLIC_WISP_URL=ws://localhost:4000/wisp/

# Sentry (optional locally — copy to .env.local; https://hudxyz.sentry.io/settings/projects/web/keys/)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# PostHog product analytics (optional locally). Enable cookieless server-hash in PostHog project settings.
# Consenting visitors get persistent identity; declined stays cookieless. Keep Vercel Web Analytics during overlap.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# c15t hosted consent backend (https://your-instance.c15t.dev). When unset, the app
# falls back to offline mode with a worldwide opt-in banner.
NEXT_PUBLIC_C15T_BACKEND_URL=

# Source map upload at build time (https://sentry.io/settings/auth-tokens/)
# SENTRY_AUTH_TOKEN=

# database
TURSO_CONNECTION_URL=
TURSO_AUTH_TOKEN=

# Cloudflare R2 — R2_ACCOUNT_ID is your Cloudflare account ID (32 hex chars), NOT the bucket name.
# Prod: hudxyz-app-assets + https://assets.hudxyz.com. Dev: hudxyz-app-assets-dev + r2.dev or assets-dev.hudxyz.com
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=hudxyz-app-assets
R2_PUBLIC_BASE_URL=https://assets.hudxyz.com

# Secrets — generate with: openssl rand -hex 32
# Admin review unlock — visit /padme?secret=<REVIEW_SECRET> (else 404). Fail closed when unset.
REVIEW_SECRET=

# Anon submit-session cookie for mutating `/api/hubs/*`. Minted on `/hubs/submit`.
SUBMIT_SESSION_SECRET=

# Created by Vercel CLI
VERCEL_OIDC_TOKEN=

# Cookie manager
NEXT_PUBLIC_C15T_BACKEND_URL=
