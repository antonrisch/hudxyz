---
// apps/glasses/src/pages/index.astro
import Layout from "../layouts/Layout.astro";
---
<Layout title="Lenswolf">
  <h1 class="text-3xl font-semibold text-center px-6">Lenswolf</h1>
  <p class="text-ink/80 text-lg text-center px-6">First light on the Display.</p>
  <button class="opt opt-sm" data-focusable autofocus>Get started</button>
</Layout>

<script>
  // shared .opt button (@lenswolf/ui/glasses.css) + shared d-pad util
  import { focusFirst, handleListNav } from "../lib/dpad";
  focusFirst(document);
  document.addEventListener("keydown", (e) => handleListNav(e, document));
</script>
